# ==========================================
# SwarmLLM Environment Configuration Template
# Copy this file to .env and configure your variables
# ==========================================

# Groq API Configuration for Fallback Mode
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Enable Fallback Mode by default (true / false)
# When set to true, requests route to Groq API with Qwen 27B instead of local WebGPU swarm
FALLBACKMODE=false

# Local Development & Demonstration Server Ports
PORT=8080
SIGNAL_PORT=9000
HOST=0.0.0.0
