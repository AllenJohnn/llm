# ==========================================
# WebSlice Environment Configuration Template
# Copy this file to .env and configure your variables
# ==========================================

# Groq API Configuration for Groq Cloud mode
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Cloud mode is the default in the room. The interface identifies the provider,
# displays the actual hosted Groq model, and tells users prompts are sent to Groq.
FALLBACKMODE=true

# Local Development & Demonstration Server Ports
PORT=8080
SIGNAL_PORT=9000
HOST=0.0.0.0
