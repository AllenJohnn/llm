{
  "name": "swarmllm",
  "version": "0.2.0",
  "description": "Peer-to-peer LLM inference across browser tabs: a from-scratch WebGPU engine and a WebRTC runtime that split one model over the devices in a room.",
  "homepage": "https://swarmllm.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllenJohnn/llm.git"
  },
  "license": "MIT",
  "author": "Allen John",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "deno test --allow-read tests/unit",
    "test:node": "node tests/unit/run_node_tests.mjs",
    "test:groq": "node tests/test_mapped_models.mjs",
    "check": "deno check engine/*.js && node --check tests/*.js benchmarks/*.js",
    "test:gpu": "bash tests/run.sh quick",
    "test:q38": "bash tests/run.sh q38",
    "test:all": "bash tests/run.sh all",
    "bench": "deno run --unstable-webgpu --allow-read --allow-env benchmarks/bench.js",
    "bench:q38": "MODEL=q38 deno run --unstable-webgpu --allow-read --allow-env benchmarks/bench.js",
    "bench:breakdown": "deno run --unstable-webgpu --allow-read --allow-env benchmarks/bench_breakdown.js",
    "serve": "node scripts/server.mjs",
    "signal": "node scripts/signal-server.mjs",
    "demo": "node scripts/demo.mjs",
    "models": "node scripts/download_model.mjs list",
    "download": "node scripts/download_model.mjs",
    "tunnel": "npx -y @ngrok/ngrok http 8080",
    "deploy:staging": "scripts/deploy-staging.sh",
    "e2e": "node tests/e2e/room.mjs"
  },
  "engines": {
    "deno": ">=2.0"
  },
  "devDependencies": {
    "peer": "^1.0.2",
    "playwright": "1.49.1"
  },
  "dependencies": {
    "marked": "^18.0.14"
  }
}
